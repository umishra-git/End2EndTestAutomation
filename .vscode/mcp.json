{
  "servers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "type": "stdio"
    },
    "playwright-test": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "playwright",
        "run-test-mcp-server"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer <ADD_GITHUB_PAT_HERE>"
      }
    },
    "GitLab": {
      "type": "http",
      "url": "https://gitlab.com/mishra-umang-project/api/v4/mcp",
      "headers": {
        "Authorization": "Bearer <ADD_GITLAB_PAT_HERE>"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    }
  },
  "inputs": []
}